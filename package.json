{
  "name": "peranto-attestation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Attester service: Didit → Peranto Liveness / ProofOfResidence JWT-VC + Aura save",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
