# Attester wallet (secp256k1) — funds needed on Paseo to anchor
ATTESTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Network + RPC
PERANTO_NETWORK=paseo
RPC_URL=https://eth-rpc-testnet.polkadot.io/

# Public origin of this service (DomainLinkage / Aura / Cloudflare tunnel)
PUBLIC_ORIGIN=http://localhost:8787

# Optional: skip on-chain anchor in local demos
ANCHOR=false

# Postgres (docker compose up -d → port 5440)
DATABASE_URL="postgresql://attestation:attestation@127.0.0.1:5440/attestation?schema=public"

# Ops / curator Aura allowlists (comma-separated). Defaults to deployment deployer + attester.
# OPS_ALLOWLIST=0x354151d1039Ba06862f8a5062b37BCb8b082cEDF
# CURATOR_ALLOWLIST=0x354151d1039Ba06862f8a5062b37BCb8b082cEDF
# CURATOR_MIN_SCORE_BPS=9000
# CURATOR_COUNTRY_ALLOWLIST=MX,CO,AR,ES,PT

# Didit
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# From Didit Console / last Approved webhook
DIDIT_WORKFLOW_ID=

PORT=8787
AUTO_ISSUE=true
